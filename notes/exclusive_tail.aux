\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Top: the exclusive cross section $\mathrm  {d}\sigma /\mathrm  {d}y\,\mathrm  {d}^2P_\perp $ (proton, $z=\genfrac  {}{}{}112$) for GBW, MVe and the BK solution at $x_{\mathbb  {P}}=10^{-3}$, and the code at fixed $q^+=2p^+$ ($y=0$, proton) where $x_{\mathbb  {P}}$ grows with $P_\perp $ (black dots). Bottom: local power $\mathrm  {d}\qopname  \relax o{ln}\sigma /\mathrm  {d}\qopname  \relax o{ln}P_\perp $ (the same as $\mathrm  {d}\qopname  \relax o{ln}F/\mathrm  {d}\qopname  \relax o{ln}P_\perp $); dotted lines at $-6$, $-8$, $-10$.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:tail}{{1}{3}{Top: the exclusive cross section $\mathrm {d}\sigma /\mathrm {d}y\,\mathrm {d}^2P_\perp $ (proton, $z=\tfrac 12$) for GBW, MVe and the BK solution at $\xpo =10^{-3}$, and the code at fixed $q^+=2p^+$ ($y=0$, proton) where $\xpo $ grows with $P_\perp $ (black dots). Bottom: local power $\mathrm {d}\ln \sigma /\mathrm {d}\ln P_\perp $ (the same as $\mathrm {d}\ln F/\mathrm {d}\ln P_\perp $); dotted lines at $-6$, $-8$, $-10$}{figure.1}{}}
