\newlabel{eq:I}{{1}{2}{1. The cross section and the fundamental dipole}{equation.0.1}{}}
\newlabel{eq:sigma}{{2}{2}{1. The cross section and the fundamental dipole}{equation.0.2}{}}
\newlabel{eq:mellin}{{3}{2}{2. The tool: large $p$ from small $r$}{equation.0.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The two terms of Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:sigma}\unskip \@@italiccorr )}} separately, $m=1.5$\nobreakspace  {}GeV, $z=1/2$, centre of Pb ($Q_{s0}^2=0.216$\nobreakspace  {}GeV$^2$). Solid: $K_1$ term $m^2(z^2+\bar  z^2)I_1^2$ (survives $m\to 0$); dashed: $K_0$ term $m^2I_0^2$ (needs the mass). Bottom: local power. Left: no evolution, GBW ($r^2$ part of the IC) and the MV$^e$ IC. Right: our rcBK-evolved dipole at fixed $x_{\mathbb  P}$. The dips of the dashed curves at $2$--$3$\nobreakspace  {}GeV are sign changes of $I_0$; the wiggles above $40$\nobreakspace  {}GeV on the right are interpolation noise of the tabulated dipole. (Standalone test, not part of the code.)}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:terms}{{1}{6}{The two terms of Eq.~\eqref {eq:sigma} separately, $m=1.5$~GeV, $z=1/2$, centre of Pb ($Q_{s0}^2=0.216$~GeV$^2$). Solid: $K_1$ term $m^2(z^2+\bar z^2)I_1^2$ (survives $m\to 0$); dashed: $K_0$ term $m^2I_0^2$ (needs the mass). Bottom: local power. Left: no evolution, GBW ($r^2$ part of the IC) and the MV$^e$ IC. Right: our rcBK-evolved dipole at fixed $x_{\mathbb P}$. The dips of the dashed curves at $2$--$3$~GeV are sign changes of $I_0$; the wiggles above $40$~GeV on the right are interpolation noise of the tabulated dipole. (Standalone test, not part of the code.)}{figure.1}{}}
